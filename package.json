{
  "name": "joy-ai-multiplatform",
  "private": true,
  "version": "1.0.0",
  "description": "CaRo Ai - asistente de IA personal multiplataforma, local-first y privado",
  "author": "CaRo Ai",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port=3000",
    "start": "electron .",
    "desktop": "vite build && electron .",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "ios:sync": "vite build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "clean": "rm -rf ../../../joy-ai-build/dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@google/genai": "^0.2.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@tailwindcss/vite": "^4.0.9",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.7.2",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.11",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "three": "^0.174.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "tar": "^7.5.23"
  }
}
